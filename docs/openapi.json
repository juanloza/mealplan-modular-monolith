{
  "components" : {
    "schemas" : {
      "ConsumedIngredient" : {
        "properties" : {
          "ingredientId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "ingredientName" : {
            "type" : "string"
          },
          "quantity" : {
            "$ref" : "#/components/schemas/QuantityDto"
          }
        },
        "type" : "object"
      },
      "CookResponse" : {
        "properties" : {
          "consumed" : {
            "items" : {
              "$ref" : "#/components/schemas/ConsumedIngredient"
            },
            "type" : "array"
          },
          "entry" : {
            "$ref" : "#/components/schemas/PlanEntryResponse"
          }
        },
        "type" : "object"
      },
      "CreateIngredientRequest" : {
        "properties" : {
          "dimension" : {
            "enum" : [ "MASS", "VOLUME", "COUNT" ],
            "type" : "string"
          },
          "name" : {
            "maxLength" : 80,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "dimension", "name" ],
        "type" : "object"
      },
      "CreatePlanEntryRequest" : {
        "properties" : {
          "plannedFor" : {
            "format" : "date",
            "type" : "string"
          },
          "recipeId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "servings" : {
            "format" : "int32",
            "maximum" : 50,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "required" : [ "plannedFor", "recipeId" ],
        "type" : "object"
      },
      "IngredientResponse" : {
        "properties" : {
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "dimension" : {
            "enum" : [ "MASS", "VOLUME", "COUNT" ],
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "PantryItemResponse" : {
        "properties" : {
          "ingredientId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "ingredientName" : {
            "type" : "string"
          },
          "quantity" : {
            "$ref" : "#/components/schemas/QuantityDto"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "PlanEntryResponse" : {
        "properties" : {
          "cancelledAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "cookedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "plannedFor" : {
            "format" : "date",
            "type" : "string"
          },
          "recipeId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "recipeTitle" : {
            "type" : "string"
          },
          "servings" : {
            "format" : "int32",
            "type" : "integer"
          },
          "status" : {
            "enum" : [ "PLANNED", "COOKED", "CANCELLED" ],
            "type" : "string"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "QuantityDto" : {
        "properties" : {
          "amount" : {
            "pattern" : "^(0|[1-9][0-9]{0,6})(\\.[0-9]{1,3})?$",
            "type" : "string"
          },
          "unit" : {
            "enum" : [ "GRAM", "KILOGRAM", "MILLILITER", "LITER", "PIECE" ],
            "type" : "string"
          }
        },
        "required" : [ "amount", "unit" ],
        "type" : "object"
      },
      "RecipeLineDto" : {
        "properties" : {
          "ingredientId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "quantity" : {
            "$ref" : "#/components/schemas/QuantityDto"
          }
        },
        "required" : [ "ingredientId", "quantity" ],
        "type" : "object"
      },
      "RecipeLineResponse" : {
        "properties" : {
          "ingredientId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "ingredientName" : {
            "type" : "string"
          },
          "quantity" : {
            "$ref" : "#/components/schemas/QuantityDto"
          }
        },
        "type" : "object"
      },
      "RecipeResponse" : {
        "properties" : {
          "archivedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "lines" : {
            "items" : {
              "$ref" : "#/components/schemas/RecipeLineResponse"
            },
            "type" : "array"
          },
          "publishedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "servings" : {
            "format" : "int32",
            "type" : "integer"
          },
          "status" : {
            "enum" : [ "DRAFT", "PUBLISHED", "ARCHIVED" ],
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          },
          "updatedAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "RegisterRequest" : {
        "properties" : {
          "email" : {
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0,
            "type" : "string"
          },
          "password" : {
            "maxLength" : 72,
            "minLength" : 12,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "RenameIngredientRequest" : {
        "properties" : {
          "name" : {
            "maxLength" : 80,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "name" ],
        "type" : "object"
      },
      "SaveRecipeRequest" : {
        "properties" : {
          "lines" : {
            "items" : {
              "$ref" : "#/components/schemas/RecipeLineDto"
            },
            "maxItems" : 50,
            "minItems" : 0,
            "type" : "array"
          },
          "servings" : {
            "format" : "int32",
            "maximum" : 50,
            "minimum" : 1,
            "type" : "integer"
          },
          "title" : {
            "maxLength" : 120,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "lines", "title" ],
        "type" : "object"
      },
      "SetPantryAmountRequest" : {
        "properties" : {
          "quantity" : {
            "$ref" : "#/components/schemas/QuantityDto"
          }
        },
        "required" : [ "quantity" ],
        "type" : "object"
      },
      "TokenResponse" : {
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "expiresInSeconds" : {
            "format" : "int64",
            "type" : "integer"
          },
          "tokenType" : {
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "UpdatePlanEntryRequest" : {
        "properties" : {
          "plannedFor" : {
            "format" : "date",
            "type" : "string"
          },
          "servings" : {
            "format" : "int32",
            "maximum" : 50,
            "minimum" : 1,
            "type" : "integer"
          }
        },
        "type" : "object"
      },
      "UserId" : {
        "properties" : {
          "value" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "UserResponse" : {
        "properties" : {
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
